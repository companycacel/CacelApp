<Window x:Class="CacelApp.Shared.Controls.ImageViewer.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CacelApp.Config.Converters" xmlns:form="clr-namespace:CacelApp.Shared.Controls.Form"
        Title="Visualizador de Imágenes"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BooleanToScrollBarVisibilityConverter x:Key="BooleanToScrollBarVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Estilo para Tabs (Texto con subrayado) -->
        <Style x:Key="ModernTabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6c757d"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Content="{TemplateBinding Content}" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="4,8,4,8"/>
                            <Border x:Name="Underline" 
                                    Grid.Row="1" 
                                    Height="3" 
                                    Background="Transparent" 
                                    HorizontalAlignment="Stretch" 
                                    CornerRadius="1.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0d6efd"/>
                                <Setter TargetName="Underline" Property="Background" Value="#0d6efd"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0d6efd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Estilo para Toggle Button Segmentado -->
        <Style x:Key="SegmentedRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
        </Style>

        <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFloatingActionButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Rediseñado -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Imágenes del Registro de Balanza" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Text="PRODUCCIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding TituloSecundario}" 
                               FontSize="14" 
                               Foreground="{DynamicResource MaterialDesignBody}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Tabs Integrados bajo el título -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <RadioButton Content="Imágenes de Pesaje" 
                                 IsChecked="{Binding MostrarPesaje, Mode=TwoWay}"
                                 Style="{StaticResource ModernTabRadioButton}"/>
                    <RadioButton Content="Imágenes de Destare" 
                                 IsChecked="{Binding MostrarDestare, Mode=TwoWay}"
                                 Style="{StaticResource ModernTabRadioButton}"
                                 Visibility="{Binding TieneImagenesDestare, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" 
                    Command="{Binding CerrarCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    VerticalAlignment="Top"
                    ToolTip="Cerrar">
                <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBody}"/>
            </Button>
        </Grid>
        
        <!-- Línea separadora de Tabs -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,0"/>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Área de Visualización -->
            <Grid Grid.Row="0" Margin="24,0,24,24">
                <!-- Carrusel de Imágenes -->
                <Grid Visibility="{Binding ModoCarrusel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botón Anterior - Circular -->
                    <Button Grid.Column="0" 
                            Command="{Binding ImagenAnteriorCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionButton}"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="28" Height="28" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </Button>

                    <!-- Contenedor de Imagen Principal -->
                    <Border Grid.Column="1" 
                            Background="Black"
                            BorderBrush="Black"
                            BorderThickness="12"
                            CornerRadius="16"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Grid ClipToBounds="True">
                            <!-- ScrollViewer para permitir desplazamiento con zoom -->
                            <ScrollViewer x:Name="ImageScrollViewer"
                                        HorizontalScrollBarVisibility="{Binding MostrarScrollBars, Converter={StaticResource BooleanToScrollBarVisibilityConverter}}"
                                        VerticalScrollBarVisibility="{Binding MostrarScrollBars, Converter={StaticResource BooleanToScrollBarVisibilityConverter}}"
                                        PanningMode="Both"
                                        PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Black">
                                <!-- Border contenedor que crece con el zoom -->
                                <Border x:Name="ZoomContainer"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        Background="Transparent">
                                    <Border.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding EscalaZoom}" 
                                                      ScaleY="{Binding EscalaZoom}"/>
                                    </Border.LayoutTransform>
                                    
                                    <!-- Imagen sin transformación adicional -->
                                    <Image Source="{Binding ImagenActual}" 
                                           Stretch="Uniform"
                                           MaxWidth="1920"
                                           MaxHeight="1080"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                           MouseMove="Image_MouseMove"
                                           MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                                </Border>
                            </ScrollViewer>

                            <!-- Overlay de Loading -->
                            <Border Background="#E0000000" 
                                    Visibility="{Binding CargandoImagen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" 
                                          VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                               IsIndeterminate="True"
                                               Width="60"
                                               Height="60"
                                               Foreground="White"/>
                                    <TextBlock Text="Cargando imagen..." 
                                             FontSize="14" 
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Contador de Imágenes - Esquina Superior Derecha -->
                            <Border Background="#CC000000" 
                                    CornerRadius="6"
                                    Padding="12,6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="12">
                                <TextBlock Foreground="White" 
                                         FontSize="14"
                                         FontWeight="Bold">
                                    <Run Text="{Binding IndiceActual, Mode=OneWay}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding TotalImagenes, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <!-- Controles de Zoom - Esquina Inferior Derecha -->
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="12">
                                <Button Command="{Binding ZoomInCommand}"
                                      Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                      Width="36"
                                      Height="36"
                                      Margin="4"
                                      Background="#CC000000"
                                      BorderBrush="Transparent"
                                      ToolTip="Acercar">
                                    <materialDesign:PackIcon Kind="MagnifyPlus" Width="18" Height="18" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding ZoomOutCommand}"
                                      Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                      Width="36"
                                      Height="36"
                                      Margin="4"
                                      Background="#CC000000"
                                      BorderBrush="Transparent"
                                      ToolTip="Alejar">
                                    <materialDesign:PackIcon Kind="MagnifyMinus" Width="18" Height="18" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding ZoomResetCommand}"
                                      Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                      Width="36"
                                      Height="36"
                                      Margin="4"
                                      Background="#CC000000"
                                      BorderBrush="Transparent"
                                      ToolTip="Restablecer zoom">
                                    <materialDesign:PackIcon Kind="MagnifyRemoveOutline" Width="18" Height="18" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding ToggleFullscreenCommand}"
                                      Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                      Width="36"
                                      Height="36"
                                      Margin="4"
                                      Background="#CC000000"
                                      BorderBrush="Transparent"
                                      ToolTip="Pantalla completa">
                                    <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Botón Siguiente - Circular -->
                    <Button Grid.Column="2" 
                            Command="{Binding ImagenSiguienteCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionButton}"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="28" Height="28" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </Button>
                </Grid>

                <!-- Vista en Cuadrícula -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding ModoGrilla, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ImagenesActuales}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" 
                                         HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesignPaper}"
                                      BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Margin="8"
                                      Width="350"
                                      Height="250"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="ImagenGrilla_Click">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="5" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Image Source="{Binding}" 
                                             Stretch="Uniform"
                                             Margin="8"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer Flotante con controles -->
        <Border Grid.Row="2" 
                Margin="24,0,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vista Mode Toggle - Estilo Segmentado -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource MaterialDesignDivider}"
                        CornerRadius="6" 
                        Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton IsChecked="{Binding ModoCarrusel, Mode=TwoWay}"
                                   Style="{StaticResource SegmentedRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewCarouselOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Carrusel"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsChecked="{Binding ModoGrilla, Mode=TwoWay}"
                                   Style="{StaticResource SegmentedRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Cuadrícula"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <form:CustomButton  Grid.Column="2" Command="{Binding CerrarCommand}"
                                   Variant="Close"
                                   Height="38"
                                   Text="Cancelar" IsOutlined="True"/>
            </Grid>
        </Border>
    </Grid>
    </Window>
