<UserControl x:Class="CacelApp.Views.Modulos.Produccion.Components.SelectionButtonGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CacelApp.Config.Converters"
             xmlns:form="clr-namespace:CacelApp.Shared.Controls.Form"
             mc:Ignorable="d" 
             KeyboardNavigation.TabNavigation="Once"
             d:DesignHeight="450" d:DesignWidth="800"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:ReflectionBindingConverter x:Key="ReflectionBindingConverter"/>
        <converters:AddIntegerConverter x:Key="AddIntegerConverter"/>
        
        <!-- ESTILO DINÁMICO para botones de selección -->
        <Style x:Key="SelectionButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{Binding ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="BorderBrush" Value="{Binding ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="{Binding ThemeColor.Color, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <ListBox ItemsSource="{Binding ItemsSource}" 
                 AlternationCount="1000"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.ScrollUnit="Pixel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Style="{StaticResource SelectionButtonStyle}"
                                 Tag="{Binding}"
                                 Checked="RadioButton_Checked"
                                 x:Name="OptionButton">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                <Binding Path="Value" />
                                <Binding Path="SelectedValue" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Índice / Código (Arriba - Centrado) -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,4">
                                <!-- Badge del número correlativo -->
                                <Border x:Name="IndexBadge" 
                                        Background="#E5E7EB" 
                                        CornerRadius="10" 
                                        Width="20" 
                                        Height="20" 
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ShowShortcut, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock x:Name="IndexNumber"
                                               Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Converter={StaticResource AddIntegerConverter}, ConverterParameter=1}" 
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Código opcional (bie_codigo) -->
                                <TextBlock x:Name="CodeText" FontSize="10" VerticalAlignment="Center" Opacity="0.7">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ReflectionBindingConverter}">
                                            <Binding />
                                            <Binding Path="CodeMemberPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </RadioButton>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=OptionButton}" Value="True">
                            <Setter TargetName="IndexBadge" Property="Background" Value="White"/>
                            <Setter TargetName="IndexBadge" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="IndexNumber" Property="Foreground" Value="{Binding ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Setter TargetName="CodeText" Property="Foreground" Value="White"/>
                            <Setter TargetName="CodeText" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
