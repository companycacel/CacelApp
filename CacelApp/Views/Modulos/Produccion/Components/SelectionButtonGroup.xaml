<UserControl x:Class="CacelApp.Views.Modulos.Produccion.Components.SelectionButtonGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CacelApp.Config.Converters"
             mc:Ignorable="d" 
             KeyboardNavigation.TabNavigation="Once"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:ReflectionBindingConverter x:Key="ReflectionBindingConverter"/>
        <converters:AddIntegerConverter x:Key="AddIntegerConverter"/>
        
        <!-- ESTILO para botones de material (Copia la lógica del HTML) -->
        <Style x:Key="MaterialButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO para botones de empaque (Verde) -->
        <Style x:Key="PackingButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#00A86B"/>
                    <Setter Property="BorderBrush" Value="#007C4A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="#00A86B"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00A86B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO para botones de material (Azul) -->
        <Style x:Key="MaterialButtonBlue" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#3B82F6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO para botones de maquinaria (Anaranjado) -->
        <Style x:Key="MachineryButtonOrange" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FED7AA"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F97316"/>
                    <Setter Property="BorderBrush" Value="#EA580C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#F97316"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#F97316"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado: Título y Paginación -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título -->
            <TextBlock Grid.Column="0" 
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#1F2937"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"/>

            <!-- Controles de Paginación -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- PANEL MIXTO: Búsqueda y Paginación -->
                
                <!-- Botón BUSCAR (LUPA) - Visible si IsSearchEnabled -->
                <Button Command="{Binding ToggleSearchCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="32"
                        Margin="0,0,16,0"
                        Padding="8,0"
                        IsTabStop="False"
                        Visibility="{Binding IsSearchEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Filtrar lista (F3)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="0,0,4,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="Buscar" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                </Button>

                <!-- Paginación - Visible si ShowPagination -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPagination, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Margin="0,0,4,0"
                            IsTabStop="False"
                            ToolTip="Página anterior">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                    </Button>

                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Margin="4,0,0,0"
                            IsTabStop="False"
                            ToolTip="Página siguiente">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        
        <!-- DIALOGO DE BÚSQUEDA INTERNO -->
        <materialDesign:DialogHost x:Name="SearchDialogHost" 
                                     IsOpen="{Binding IsSearchDialogOpen}" 
                                     Panel.ZIndex="1000"
                                     IsTabStop="False"
                                     CloseOnClickAway="True"
                                     DialogContentUniformCornerRadius="10">
            <materialDesign:DialogHost.DialogContent>
                <Border Width="500" Height="400" Padding="20" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Buscar elemento..." FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource MaterialDesignBody}"/>
                        
                        <TextBox Grid.Row="1"
                                 x:Name="SearchBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Escriba filtro..."
                                 IsTabStop="False"
                                 Margin="0,0,0,16"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                 
                        <ListBox Grid.Row="2"
                                 x:Name="SearchResultsList"
                                 ItemsSource="{Binding FilteredItems}"
                                 DisplayMemberPath="Label"
                                 IsTabStop="False"
                                 SelectionChanged="SearchResultsList_SelectionChanged"
                                 PreviewKeyDown="SearchResultsList_PreviewKeyDown"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontSize="16"/>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Lista de Botones -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding PagedItems}" AlternationCount="100">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Tag="{Binding Value}"
                                 Checked="RadioButton_Checked"
                                 Style="{Binding CurrentButtonStyle, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        
                        <!-- Binding IsChecked Bidireccional -->
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                <Binding Path="Value"/>
                                <Binding Path="SelectedValue" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </RadioButton.IsChecked>

                        <!-- Contenido VISUAL del Botón -->
                        <Grid>
                            <!-- Badge Numérico (Atajo de teclado) -->
                            <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                    CornerRadius="4" 
                                    Width="20" Height="20"
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top"
                                    Margin="4"
                                    Panel.ZIndex="10"
                                    Opacity="0.8">
                                <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource AddIntegerConverter}, ConverterParameter=1}"
                                           Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Contenido del Botón (Texto Simple o Doble) -->
                            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" 
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           ToolTip="{Binding Label}"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Double">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <StackPanel>                                                           
                                                            <TextBlock FontSize="20" 
                                                                       FontWeight="Bold" 
                                                                       HorizontalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource ReflectionBindingConverter}">
                                                                        <Binding />
                                                                        <Binding Path="CodeMemberPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Label}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Normal" 
                                                                       Margin="0,2,0,0" 
                                                                       HorizontalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Label}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        </Grid>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
