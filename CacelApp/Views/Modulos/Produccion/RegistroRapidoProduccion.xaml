<Window x:Class="CacelApp.Views.Modulos.Produccion.RegistroRapidoProduccion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CacelApp.Config.Converters"
        xmlns:form="clr-namespace:CacelApp.Shared.Controls.Form"
        xmlns:loading="clr-namespace:CacelApp.Shared.Controls.Loading"
        xmlns:weightDisplay="clr-namespace:CacelApp.Shared.Controls.WeightDisplay"
        xmlns:components="clr-namespace:CacelApp.Views.Modulos.Produccion.Components"
        xmlns:controls="clr-namespace:CacelApp.Shared.Controls.Form"
        mc:Ignorable="d"
        Title="Registro Rápido de Producción" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F4F6">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- CONVERSORES (ASUMIDOS) -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        
        <!-- Converters de Pasos (Unificados para reaccionar a CurrentStep) -->
        <converters:StepToColorConverter x:Key="StepToColorConverter" ActiveBrush="#3B82F6"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <!-- VARIABLES DE COLOR (Simulando el CSS vivo) -->
        <!-- NOTA: Debes definir AppPrimaryBrush en tu App.xaml o recursos globales -->
        <SolidColorBrush x:Key="VivoPrimaryBrush" Color="#00A86B"/>
        <SolidColorBrush x:Key="VivoSecondaryBrush" Color="#007C4A"/>
        <SolidColorBrush x:Key="InputTaraBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InputTaraForeground" Color="#92400E"/>
        <SolidColorBrush x:Key="NetoBackgroundBrush" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="NetoForegroundBrush" Color="#065F46"/>

        <!-- ESTILO para botones de material (Copia la lógica del HTML) -->
        <Style x:Key="MaterialButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO para botones de empaque (Simulando el RadioButton con Template) -->
        <Style x:Key="PackingButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource VivoPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VivoSecondaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="#00A86B"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource VivoPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO para botones de material (Azul) -->
        <Style x:Key="MaterialButtonBlue" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#3B82F6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO para botones de maquinaria (Anaranjado) -->
        <Style x:Key="MachineryButtonOrange" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Background" Value="#FED7AA"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F97316"/>
                    <Setter Property="BorderBrush" Value="#EA580C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#F97316"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#F97316"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <materialDesign:DialogHost Identifier="RegistroRapidoProduccionDialogHost" 
                                 CloseOnClickAway="False"
                                 Style="{StaticResource MaterialDesignEmbeddedDialogHost}"
                                 OverlayBackground="#B3000000"
                                 materialDesign:DialogHost.DialogContentTemplate="{StaticResource AppDialogTemplate}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--<loading:LoadingOverlay Grid.RowSpan="3" Panel.ZIndex="99999" 
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Loaded="LoadingOverlay_Loaded"/>-->

            <!-- Header -->
            <Border Grid.Row="0" 
                Padding="24,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ScaleBalance" 
                                         Width="32" 
                                         Height="32" 
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                         VerticalAlignment="Center" 
                                         Margin="0,0,15,0"/>
                    <TextBlock Text="Estación de Pesaje de Materiales"
                           FontSize="24"
                           FontWeight="Bold"
                            Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20"
                      Focusable="False"
                      Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel Margin="16,16,16,0">

                    <!-- GRUPO PRINCIPAL: Materiales (Izq) & Visor (Der) -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <!-- 3/5 para Materiales -->
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="3*"/>
                            <!-- 2/5 para Visor -->
                        </Grid.ColumnDefinitions>

                        <!-- Columna 0 (Izquierda): 1. Visor -->
                        <StackPanel Grid.Column="0">
                            <!-- Título de Sección 1 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=1}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Visor de Peso (KG)" FontSize="18" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                            </StackPanel>

                             <!-- Visor de Peso Dinámico -->
                             <weightDisplay:WeightDisplayControl x:Name="VisorControl"
                                  TabIndex="1" Focusable="True" FocusVisualStyle="{x:Null}"
                                  BalanzaNombre="{Binding PrimeraBalanza.Nombre, FallbackValue='BALANZA'}"
                                  PesoActual="{Binding PrimeraBalanza.PesoActual}"
                                  ColorBorde="#10B981"
                                  Conectada="{Binding PrimeraBalanza.Conectada}"
                                  CapturarCommand="{Binding PrimeraBalanza.CapturarCommand}"
                                  Visibility="{Binding PrimeraBalanza, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Columna 2 (Derecha): 2. Visor de Peso -->
                        <StackPanel Grid.Column="2">


                            <!-- Título de Sección 2 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=2}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Material" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Componente Único Inteligente -->
                            <components:SelectionButtonGroup x:Name="GroupMaterial" 
                                AutoOpenSearchOnFocus="True"
                                TabIndex="2"
                                ItemsSource="{Binding Materiales}"
                                SelectedValue="{Binding MaterialSeleccionado, Mode=TwoWay}"
                                Checked="Material_Checked"
                                GroupName="Material"
                                ThemeColor="#3B82F6"
                                DisplayMode="Double"
                                ItemsPerPage="6"
                                Rows="2"
                                Columns="3"
                                CodeMemberPath="Ext.bie_codigo"
                                Height="200"/>
                        </StackPanel>
                    </Grid>

                    <!-- GRUPO DE CONTROL: Empaque (Izq) & Capturar (Der) -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>

                        </Grid.ColumnDefinitions> 

                        <!-- Columna 0 (Izquierda): 3. Unidad de Medida -->
                        <StackPanel Grid.Column="0">
                            <!-- Título de Sección 3 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=3}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Unidad de Medida" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <components:SelectionButtonGroup x:Name="GroupUnidad"
                                TabIndex="3"
                                ItemsSource="{Binding UnidadesMedida}"
                                SelectedValue="{Binding UnidadMedidaSeleccionada, Mode=TwoWay}"
                                GroupName="UnidadMedida"
                                ThemeColor="#00A86B"
                                DisplayMode="Single"
                                ItemsPerPage="0"
                                Rows="1"
                                Columns="3"
                                Checked="UnidadMedida_Checked"/>
                        </StackPanel>

                        <!-- Columna 1 (Derecha): 4. Maquinaria -->
                        <StackPanel Grid.Column="1">
                            <!-- Título de Sección 4 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=4}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                    <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Maquinaria" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <components:SelectionButtonGroup x:Name="GroupMaquinaria" x:FieldModifier="public"
                                TabIndex="4"
                                ItemsSource="{Binding Maquinaria}"
                                SelectedValue="{Binding Pes_veh_id, Mode=TwoWay}"
                                Checked="Maquinaria_Checked"
                                GroupName="Maquinaria"
                                ThemeColor="#F97316"
                                DisplayMode="Single"
                                ItemsPerPage="0"
                                Columns="2"
                                Height="150"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4. Resultados de Pesaje (Bruto, Tara, Neto) -->



                    <Grid Margin="0,30,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Título de Sección 5 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=5}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock Text="5" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Resultados de Pesaje" FontSize="18" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Peso Bruto -->
                        <Border Grid.Row="1" Grid.Column="0"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="PESO BRUTO" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding PesoBruto, StringFormat='0.00'}" FontSize="20" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
                                        <TextBlock Text="KG" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                        </Border>

                                <!-- Peso Tara (Manual) -->
                                <Border Grid.Row="1" Grid.Column="1"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="PESO TARA (Manual)" FontSize="12" Foreground="{StaticResource InputTaraForeground}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <Border BorderThickness="2"
                                                BorderBrush="#D97706"
                                                Background="White"
                                                CornerRadius="6"
                                                Width="120"
                                                Height="40"
                                                HorizontalAlignment="Center">
                                            <TextBox x:Name="TxtTara" TabIndex="5"
                                                     Text="{Binding PesoTara, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='0.00'}"
                                                     FontSize="20"
                                                     FontWeight="Bold"
                                                     Foreground="{StaticResource InputTaraForeground}"
                                                     TextAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     Padding="8,0"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                     GotFocus="TxtTara_GotFocus"/>
                                        </Border>
                                        <TextBlock Text="KG" FontSize="14" Foreground="{StaticResource InputTaraForeground}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Peso Neto -->
                                <Border Grid.Row="1" Grid.Column="2"
                                    Background="{StaticResource NetoBackgroundBrush}"
                                    BorderBrush="{StaticResource VivoPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="PESO NETO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource NetoForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding PesoNeto, StringFormat='0.00'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NetoForegroundBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="KG" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NetoForegroundBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>


                            </Grid>
                      

                </StackPanel>
            </ScrollViewer>

            <!-- Botones de Acción al Final (Footer) -->
            <Border Grid.Row="2" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <form:CustomButton Command="{Binding CancelarCommand}"
                                   Variant="Close"
                                   Height="38"
                                   Margin="0,0,12,0" 
                                   Text="Cancelar"/>

                    <form:CustomButton Command="{Binding GuardarCommand}"
                                   Variant="Save"
                                   Height="38"
                                   Text="Guardar Pesada"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>