<Window x:Class="CacelApp.Views.Modulos.Produccion.RegistroRapidoProduccion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CacelApp.Config.Converters"
        xmlns:form="clr-namespace:CacelApp.Shared.Controls.Form"
        xmlns:loading="clr-namespace:CacelApp.Shared.Controls.Loading"
        xmlns:weightDisplay="clr-namespace:CacelApp.Shared.Controls.WeightDisplay"
        xmlns:components="clr-namespace:CacelApp.Views.Modulos.Produccion.Components"
        xmlns:controls="clr-namespace:CacelApp.Shared.Controls.Form"
        mc:Ignorable="d"
        Title="Registro Rápido de Producción" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F4F6">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- CONVERSORES (ASUMIDOS) -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        
        <!-- Converters de Pasos (Unificados para reaccionar a CurrentStep) -->
        <converters:StepToColorConverter x:Key="StepToColorConverter" ActiveBrush="#3B82F6"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <!-- VARIABLES DE COLOR (Simulando el CSS vivo) -->
        <!-- NOTA: Debes definir AppPrimaryBrush en tu App.xaml o recursos globales -->
        <SolidColorBrush x:Key="VivoPrimaryBrush" Color="#00A86B"/>
        <SolidColorBrush x:Key="VivoSecondaryBrush" Color="#007C4A"/>
        <SolidColorBrush x:Key="InputTaraBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InputTaraForeground" Color="#92400E"/>
        <SolidColorBrush x:Key="NetoBackgroundBrush" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="NetoForegroundBrush" Color="#065F46"/>

        <!-- ESTILO para botones de material (Copia la lógica del HTML) -->
        <Style x:Key="MaterialButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO para botones de empaque (Simulando el RadioButton con Template) -->
        <Style x:Key="PackingButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource VivoPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VivoSecondaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="#00A86B"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource VivoPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO para botones de material (Azul) -->
        <Style x:Key="MaterialButtonBlue" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#3B82F6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO para botones de maquinaria (Anaranjado) -->
        <Style x:Key="MachineryButtonOrange" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Background" Value="#FED7AA"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F97316"/>
                    <Setter Property="BorderBrush" Value="#EA580C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#F97316"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#F97316"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <materialDesign:DialogHost Identifier="RegistroRapidoProduccionDialogHost" 
                                 CloseOnClickAway="False"
                                 Style="{StaticResource MaterialDesignEmbeddedDialogHost}"
                                 OverlayBackground="#B3000000"
                                 materialDesign:DialogHost.DialogContentTemplate="{StaticResource AppDialogTemplate}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--<loading:LoadingOverlay Grid.RowSpan="3" Panel.ZIndex="99999" 
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Loaded="LoadingOverlay_Loaded"/>-->

            <!-- Header -->
            <Border Grid.Row="0" 
                Padding="24,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ScaleBalance" 
                                         Width="32" 
                                         Height="32" 
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                         VerticalAlignment="Center" 
                                         Margin="0,0,15,0"/>
                    <TextBlock Text="Estación de Pesaje de Materiales"
                           FontSize="24"
                           FontWeight="Bold"
                            Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="20"
                      Focusable="False"
                      Background="{DynamicResource MaterialDesignPaper}">

                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/> <!-- Columna Fija Izquierda -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/> <!-- Columna Flexible Derecha -->
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA: BÁSCULA Y MATERIAL -->
                    <StackPanel Grid.Column="0">
                        <!-- 1. LECTURA DE BÁSCULA -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,20" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#1F2937" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="LECTURA DE BÁSCULA" FontSize="14" FontWeight="Bold" Foreground="#4B5563" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Visor de Peso Dinámico -->
                                <weightDisplay:WeightDisplayControl x:Name="VisorControl"
                                      TabIndex="1" Focusable="True" FocusVisualStyle="{x:Null}"
                                      BalanzaNombre="{Binding PrimeraBalanza.Nombre, FallbackValue='BALANZA'}"
                                      PesoActual="{Binding PrimeraBalanza.PesoActual}"
                                      ColorBorde="#10B981"
                                      Conectada="{Binding PrimeraBalanza.Conectada}"
                                      CapturarCommand="{Binding PrimeraBalanza.CapturarCommand}"
                                      Visibility="{Binding PrimeraBalanza, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                                <!-- 2. MATERIALES -->
                                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="#1F2937" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                            <TextBlock Text="MATERIAL" FontSize="14" FontWeight="Bold" Foreground="#4B5563" VerticalAlignment="Center"/>
                                        </StackPanel>

                                         <components:SelectionButtonGroup x:Name="GroupMaterial" 
                                            TabIndex="2"
                                            SearchLabel="Seleccionar material o escribir código..."
                                            IsComboBoxVisible="True"
                                            ExtData="{Binding MaterialExtData, Mode=TwoWay}"
                                            IsSearchInlineEnabled="False"
                                            IsSearchEnabled="False"
                                            ItemsSource="{Binding Materiales}"
                                            SelectedValue="{Binding MaterialSeleccionado, Mode=TwoWay}"
                                            GroupName="Material"
                                            ThemeColor="#3B82F6"
                                            DisplayMode="Single"
                                            ItemsPerPage="8"
                                            Rows="4"
                                            Columns="2"
                                            CodeMemberPath="Ext.bie_codigo"
                                            Height="420"/>
                                    </StackPanel>
                                </Border>
                    </StackPanel>

                    <!-- COLUMNA DERECHA: CÁMARAS, UNIDADES, MAQUINARIA Y PESOS -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Cámaras -->
                            <RowDefinition Height="Auto"/> <!-- Unidad -->
                            <RowDefinition Height="Auto"/> <!-- Maquinaria -->
                            <RowDefinition Height="*"/>    <!-- Obs y Pesos -->
                        </Grid.RowDefinitions>

                        <!-- CÁMARAS -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#111827" Height="200" CornerRadius="8" Padding="10">
                                <Grid>
                                    <Border Background="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4,2" CornerRadius="4">
                                        <TextBlock Text="REC" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="CÁMARA FRONTAL 01" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#111827" Height="200" CornerRadius="8" Padding="10">
                                <Grid>
                                    <materialDesign:PackIcon Kind="Camera" Foreground="#4B5563" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20"/>
                                    <TextBlock Text="CÁMARA CARGA 02" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 3. UNIDAD -->
                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,20" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#9CA3AF" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="UNIDAD" FontSize="14" FontWeight="Bold" Foreground="#4B5563" VerticalAlignment="Center"/>
                                </StackPanel>

                                <components:SelectionButtonGroup x:Name="GroupUnidad"
                                    TabIndex="3"
                                    ItemsSource="{Binding UnidadesMedida}"
                                    SelectedValue="{Binding UnidadMedidaSeleccionada, Mode=TwoWay}"
                                    GroupName="UnidadMedida"
                                    ThemeColor="#10B981"
                                    DisplayMode="Double"
                                    IsSearchEnabled="False"
                                    ItemsPerPage="0"
                                    Rows="1"
                                    Columns="4"
                                    Checked="UnidadMedida_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. MAQUINARIA -->
                        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#9CA3AF" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="COMPACTADORA" FontSize="14" FontWeight="Bold" Foreground="#4B5563" VerticalAlignment="Center"/>
                                </StackPanel>

                                <components:SelectionButtonGroup x:Name="GroupMaquinaria" x:FieldModifier="public"
                                    TabIndex="4"
                                    ItemsSource="{Binding Maquinaria}"
                                    SelectedValue="{Binding Pes_veh_id, Mode=TwoWay}"
                                    Checked="Maquinaria_Checked"
                                    GroupName="Maquinaria"
                                    ThemeColor="#F97316"
                                    DisplayMode="Double"
                                    IsSearchEnabled="False"
                                    ItemsPerPage="0"
                                    Rows="1"
                                    Columns="4"
                                    Height="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- BOTTOM: OBSERVACIONES Y PESOS -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- OBSERVACIONES -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CommentOutline" Foreground="#9CA3AF" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="OBSERVACIONES" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox Text="{Binding Observaciones}" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         MinHeight="120"
                                         materialDesign:HintAssist.Hint="Notas adicionales..."
                                         Background="White"/>
                            </StackPanel>

                            <!-- PESOS VERTICALES (Estilo Factura) -->
                            <Grid Grid.Column="1" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- BRUTO -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="BRUTO" FontSize="36" FontWeight="ExtraBold" Foreground="#111827" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PesoBruto, StringFormat='0.00'}" FontSize="48" FontWeight="ExtraBold" Foreground="#111827" TextAlignment="Right"/>

                                <!-- TARA -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="TARA" FontSize="36" FontWeight="ExtraBold" Foreground="#111827" VerticalAlignment="Center" Margin="0,10"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtTara" 
                                             Text="{Binding PesoTara, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='0.00'}"
                                             FontSize="48" FontWeight="ExtraBold" Foreground="#EF4444" 
                                             BorderThickness="0" Background="Transparent" TextAlignment="Right"
                                             MinWidth="150"
                                             GotFocus="TxtTara_GotFocus"/>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="20" Height="20" Padding="0">
                                            <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="20" Height="20" Padding="0">
                                            <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- NETO -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="NETO" FontSize="36" FontWeight="ExtraBold" Foreground="#111827" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PesoNeto, StringFormat='0.00'}" FontSize="64" FontWeight="ExtraBold" Foreground="#10B981" TextAlignment="Right"/>
                                    <TextBlock Text="KG" FontSize="24" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Botones de Acción al Final (Footer) -->
            <Border Grid.Row="2" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <form:CustomButton Command="{Binding CancelarCommand}"
                                   Variant="Close"
                                   Height="38"
                                   Margin="0,0,12,0" 
                                   Text="Cancelar"/>

                    <form:CustomButton Command="{Binding GuardarCommand}"
                                   Variant="Save"
                                   Height="38"
                                   Text="Guardar Pesada"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>